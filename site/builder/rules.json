 "notes": [
  {
   "command": "scan",
   "when": {
    "all": [
     {
      "set": "likelihood"
     },
     {
      "any": [
       {
        "set": "likelihood_config"
       },
       {
        "set": "fail_on_likelihood"
       }
      ]
     }
    ]
   },
   "message": "--likelihood-config and --fail-on-likelihood switch on --likelihood; it does not need to be given as well."
  },
  {
   "command": "scan",
   "when": {
    "all": [
     {
      "set": "path"
     },
     {
      "any": [
       {
        "set": "offline"
       },
       {
        "set": "scanners"
       }
      ]
     }
    ]
   },
   "message": "With --path, some checks depend on the file: a package inventory or SBOM is checked against OSV and needs the network, while a lockfile or artifact uses the scanners. oss-intake reports any conflict before it starts work."
  }
 ]
