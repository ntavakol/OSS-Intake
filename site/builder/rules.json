{
 "about": "Checks the command builder makes before it lets a command be copied: the cross-option and value checks oss-intake makes before any work (cmd_scan's and cmd_verify's validation, and the gate checks after the scanners are chosen). argparse checks (types, choices, required options, the verify either-or pair) come from options.json. Checks that need the file system are left out. tests/test_builder.py runs every rule's args through the real CLI, expecting exit 2 and the rule's message, and its ok_args (the nearest command the CLI accepts), which must not get that message; field checks are tested the same way. When the CLI's checks change, change this file to match.",
 "fields": [
  {
   "command": "scan",
   "dest": "image",
   "pattern": "^(?:[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]{1,5})?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*(?::[A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?(?:@sha256:[a-f0-9]{64})?$",
   "message": "not a valid image reference (e.g. owner/name:1.2.3)",
   "valid": [
    "owner/app:1.2.3",
    "nginx:1.27",
    "ghcr.io/owner/app@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
   ],
   "invalid": [
    "Owner/App:1",
    "owner/app:-x"
   ]
  },
  {
   "command": "scan",
   "dest": "image",
   "pattern": "(?::[^/]*$|@)",
   "message": "must include an explicit tag or digest; 'latest' by omission is not assessed",
   "valid": [
    "owner/app:1.2.3",
    "registry:5000/app:1"
   ],
   "invalid": [
    "owner/app",
    "registry:5000/app"
   ]
  },
  {
   "command": "scan",
   "dest": "repo",
   "pattern": "^(?:(?:https?://)?(?:www\\.)?github\\.com/)?[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/(?!\\.git/?$)[A-Za-z0-9._-]{1,100}?(?:\\.git)?/?$",
   "message": "must be a GitHub repository as owner/name",
   "valid": [
    "owner/name",
    "https://github.com/owner/name",
    "owner/name.git"
   ],
   "invalid": [
    "owner",
    "owner/name/extra",
    "-owner/name",
    "owner/.git"
   ]
  },
  {
   "command": "scan",
   "dest": "release_date",
   "date": true,
   "message": "must be a real date as YYYY-MM-DD",
   "valid": [
    "2026-01-31"
   ],
   "invalid": [
    "2026-02-30",
    "31/01/2026",
    "2026-1-5"
   ]
  },
  {
   "command": "scan",
   "dest": "as_of",
   "date": true,
   "message": "must be a real date as YYYY-MM-DD",
   "valid": [
    "2026-11-04"
   ],
   "invalid": [
    "2026-13-01",
    "today"
   ]
  },
  {
   "command": "scan",
   "dest": "fail_on",
   "list_of": [
    "act",
    "critical",
    "high",
    "kev",
    "malicious",
    "mismatch",
    "recent",
    "unchecked",
    "unknown-age"
   ],
   "message": "unknown value",
   "valid": [
    "malicious,kev,high",
    "act"
   ],
   "invalid": [
    "malware",
    "kev,,x"
   ]
  },
  {
   "command": "scan",
   "dest": "formats",
   "list_of": [
    "csv",
    "html",
    "json",
    "md",
    "sarif"
   ],
   "message": "unknown value",
   "valid": [
    "csv,html"
   ],
   "invalid": [
    "pdf",
    ","
   ]
  },
  {
   "command": "scan",
   "dest": "scanners",
   "list_of": [
    "auto",
    "grype",
    "osv",
    "trivy"
   ],
   "auto_alone": true,
   "message": "unknown value",
   "valid": [
    "trivy,osv",
    "auto"
   ],
   "invalid": [
    "snyk",
    "auto,trivy",
    "AUTO",
    "auto,"
   ]
  },
  {
   "command": "scan",
   "dest": "trivy_sha256",
   "pattern": "^\\s*(?:[Ss][Hh][Aa]256:)?[0-9A-Fa-f]{64}\\s*$",
   "message": "expected a 64 character hexadecimal SHA-256 value",
   "valid": [
    "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
   ],
   "invalid": [
    "abc"
   ]
  },
  {
   "command": "scan",
   "dest": "grype_sha256",
   "pattern": "^\\s*(?:[Ss][Hh][Aa]256:)?[0-9A-Fa-f]{64}\\s*$",
   "message": "expected a 64 character hexadecimal SHA-256 value",
   "valid": [
    "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
   ],
   "invalid": [
    "xyz"
   ]
  },
  {
   "command": "scan",
   "dest": "govulncheck_sha256",
   "pattern": "^\\s*(?:[Ss][Hh][Aa]256:)?[0-9A-Fa-f]{64}\\s*$",
   "message": "expected a 64 character hexadecimal SHA-256 value",
   "valid": [
    "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
   ],
   "invalid": [
    "123"
   ]
  },
  {
   "command": "scan",
   "dest": "label",
   "pattern": "^\\s*[A-Za-z][A-Za-z0-9_ -]{0,39}\\s*=\\s*\\S.*$",
   "message": "use key=value, with a key of letters, digits, spaces, - or _",
   "valid": [
    "owner=Web team",
    "system=payments"
   ],
   "invalid": [
    "owner",
    "=x",
    "1x=y"
   ]
  },
  {
   "command": "scan",
   "dest": "label",
   "not_keys": [
    "compare_version",
    "critical",
    "ecosystem",
    "findings",
    "group",
    "high",
    "kev",
    "labels",
    "latest",
    "latest_left",
    "latest_major",
    "malicious",
    "name",
    "new_release",
    "no_fix",
    "package",
    "published",
    "purl",
    "systems",
    "upgrade_left",
    "upgrade_major",
    "upgrade_to",
    "upgrade_version",
    "version"
   ],
   "message": "is a column oss-intake fills in (packages.csv); use another name",
   "valid": [
    "owner=Web",
    "team=a"
   ],
   "invalid": [
    "name=x",
    "Version=1",
    "purl=p"
   ]
  },
  {
   "command": "scan",
   "dest": "scanner_env",
   "pattern": "^(?=.*[A-Za-z0-9_()])[A-Za-z0-9_*?()]+$",
   "message": "name an environment variable or a pattern such as 'AWS_*'",
   "valid": [
    "AWS_*",
    "AZURE_CLIENT_ID",
    "GOOGLE_?PPLICATION_CREDENTIALS"
   ],
   "invalid": [
    "*",
    "A-B",
    "*?",
    "AWS *"
   ]
  },
  {
   "command": "scan",
   "dest": "package",
   "pattern": "^\\s*(?:[Pp][Kk][Gg]:[A-Za-z]+/\\S+@\\S+|\\.?[A-Za-z][A-Za-z0-9.-]*:\\S+@\\S+)\\s*$",
   "message": "invalid --package value",
   "valid": [
    "npm:chalk@5.6.1",
    "pkg:pypi/django@2.2.0",
    "npm:@ctrl/tinycolor@4.1.1",
    "maven:org.a:b@1.0",
    ".net:Newtonsoft.Json@13.0.1"
   ],
   "invalid": [
    "chalk",
    "npm:chalk",
    "npm:chalk@5.6.1 x"
   ]
  },
  {
   "command": "verify",
   "dest": "sha256",
   "pattern": "^\\s*(?:[Ss][Hh][Aa]256:)?[0-9A-Fa-f]{64}\\s*$",
   "message": "expected a 64 character hexadecimal SHA-256 value",
   "valid": [
    "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
   ],
   "invalid": [
    "abc"
   ]
  }
 ],
 "rules": [
  {
   "id": "input-required",
   "command": "scan",
   "when": {
    "none": [
     "image",
     "path",
     "package",
     "repo"
    ]
   },
   "message": "give --image, --path, --package or --repo",
   "args": [
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--repo",
    "owner/name",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "image-and-path",
   "command": "scan",
   "when": {
    "all": [
     {
      "set": "image"
     },
     {
      "set": "path"
     }
    ]
   },
   "message": "give --image or --path, not both",
   "args": [
    "--image",
    "owner/app:1.0",
    "--path",
    "x.csv",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--image",
    "owner/app:1.0",
    "--repo",
    "owner/name",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "package-alone",
   "command": "scan",
   "when": {
    "all": [
     {
      "set": "package"
     },
     {
      "any": [
       {
        "set": "image"
       },
       {
        "set": "path"
       }
      ]
     }
    ]
   },
   "message": "give --package on its own, not with --image or --path",
   "args": [
    "--package",
    "npm:chalk@5.6.1",
    "--image",
    "owner/app:1.0",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--package",
    "npm:chalk@5.6.1",
    "--repo",
    "owner/name",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "package-offline",
   "command": "scan",
   "when": {
    "all": [
     {
      "set": "package"
     },
     {
      "set": "offline"
     }
    ]
   },
   "message": "is checked against OSV, which needs the network; drop --offline",
   "args": [
    "--package",
    "npm:chalk@5.6.1",
    "--offline",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--package",
    "npm:chalk@5.6.1",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "release-age-max",
   "command": "scan",
   "when": {
    "lt": [
     "release_age_max",
     1
    ]
   },
   "message": "--release-age-max must be 1 or more",
   "args": [
    "--image",
    "owner/app:1.0",
    "--release-age-max",
    "0",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--image",
    "owner/app:1.0",
    "--release-age-max",
    "1",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "cache-dir-and-no-cache",
   "command": "scan",
   "when": {
    "all": [
     {
      "set": "cache_dir"
     },
     {
      "set": "no_cache"
     }
    ]
   },
   "message": "--cache-dir and --no-cache cannot be used together",
   "args": [
    "--image",
    "owner/app:1.0",
    "--cache-dir",
    "c",
    "--no-cache",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--image",
    "owner/app:1.0",
    "--no-cache",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "trust-cache-dir-needs-cache-dir",
   "command": "scan",
   "when": {
    "all": [
     {
      "set": "trust_cache_dir"
     },
     {
      "not": {
       "set": "cache_dir"
      }
     }
    ]
   },
   "message": "--trust-cache-dir needs --cache-dir",
   "args": [
    "--image",
    "owner/app:1.0",
    "--trust-cache-dir",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--image",
    "owner/app:1.0",
    "--cache-dir",
    "{out}-cache",
    "--trust-cache-dir",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "release-age-days",
   "command": "scan",
   "when": {
    "lt": [
     "release_age_days",
     0
    ]
   },
   "message": "--release-age-days must be zero or more",
   "args": [
    "--image",
    "owner/app:1.0",
    "--release-age-days=-1",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--image",
    "owner/app:1.0",
    "--release-age-days",
    "0",
    "--out",
    "{out}"
   ]
  },
  {
   "id": "trivy-cosign-certificate-pair",
   "command": "scan",
   "when": {
    "any": [
     {
      "all": [
       {
        "set": "trivy_cosign_certificate"
       },
       {
        "not": {
         "set": "trivy_cosign_signature"
        }
       }
      ]
     },
     {
      "all": [
       {
        "set": "trivy_cosign_signature"
       },
       {
        "not": {
         "set": "trivy_cosign_certificate"
        }
       }
      ]
     }
    ]
   },
   "message": "--trivy-cosign-certificate and --trivy-cosign-signature go together",
   "args": [
    "--image",
    "owner/app:1.0",
    "--scanners",
    "trivy",
    "--trivy-archive",
    "{file}",
    "--trivy-checksums",
    "{file}",
    "--trivy-cosign-certificate",
    "{file}",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--image",
    "owner/app:1.0",
    "--scanners",
    "trivy",
    "--trivy-archive",
    "{file}",
    "--trivy-checksums",
    "{file}",
    "--trivy-cosign-certificate",
    "{file}",
    "--trivy-cosign-signature",
    "{file}",
    "--out",
    "{out}"
   ]
  },
  {
