    "{file}",
    "--trivy-cosign-signature",
    "{file}",
    "--trivy-cosign-bundle",
    "{file}",
    "--out",
    "{out}"
   ],
   "ok_args": [
    "--image",
    "owner/app:1.0",
    "--scanners",
    "trivy",
    "--trivy-archive",
    "{file}",
    "--trivy-checksums",
    "{file}",
    "--trivy-cosign-certificate",
    "{file}",
