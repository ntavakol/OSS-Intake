{
 "about": "Answers to the wizard and the command it must build. tests/builder/wizard.test.mjs walks each through the wizard's steps; tests/test_builder.py runs each command through the CLI, which must accept it.",
 "cases": [
  {"name": "extension lockfile, likelihood gate", "what": "lockfile", "outcome": "gate",
   "values": {"path": "~/Downloads/vscode-extension/package-lock.json", "repo": "owner/vscode-extension", "out": "extension-report", "fail_on_likelihood": "4"},
