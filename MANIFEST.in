# The sdist carries what the test suite needs, so `pytest` runs from an unpacked sdist.
graft tests
graft examples
include scripts/readme_sync.py scripts/self_inventory.py scripts/release_sbom.py
include requirements/runtime.txt requirements/dev.txt
include CHANGELOG.md BACKLOG.md CONTRIBUTING.md SECURITY.md
global-exclude __pycache__ *.py[cod]
